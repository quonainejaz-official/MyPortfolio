# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com/ (it is emailed to you after verification).
# The key decides which inbox receives the messages.
#
# Local:  copy this file to `.env` and fill in the key.
# Vercel: Project Settings -> Environment Variables -> add the same key, then redeploy
#         (this value is baked in at build time, so a redeploy is required).
VITE_WEB3FORMS_ACCESS_KEY=
